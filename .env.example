# ──────────────────────────────────────────────────────────────────────────────
# GigFlow – Smart Leads Dashboard  ·  Environment Variables
# ──────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in the values.
# NEVER commit your real .env to source control.
# ──────────────────────────────────────────────────────────────────────────────

# ── Backend ───────────────────────────────────────────────────────────────────

# MongoDB connection string (local or Atlas)
# Local:  mongodb://localhost:27017/smart-leads
# Atlas:  mongodb+srv://<user>:<password>@cluster0.xxxx.mongodb.net/smart-leads
MONGODB_URI=mongodb://localhost:27017/smart-leads

# JWT signing secret — use a long random string in production
# Generate one: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_string_in_production

# Token expiry (e.g. 7d, 24h, 60m)
JWT_EXPIRES_IN=7d

# Express server port
PORT=5000

# Node environment: development | production | test
NODE_ENV=development

# Allowed frontend origin for CORS
CLIENT_URL=http://localhost:5173

# ── Frontend ──────────────────────────────────────────────────────────────────

# Backend API base URL used by Vite / the React app
# In Docker, nginx proxies /api -> backend, so keep this as /api
VITE_API_URL=http://localhost:5000/api
