# Backend environment variables (development only)
# Copy to .env — never commit secrets

# MongoDB Atlas Connection
# Format: mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/DATABASE_NAME
# Example: mongodb+srv://user123:Pass@1234@cluster0.abc123xyz.mongodb.net/smart_leads
MONGODB_URI=mongodb+srv://username:password@cluster-name.mongodb.net/database_name

# JWT Configuration
JWT_SECRET=change_this_to_a_long_random_string_in_production
JWT_EXPIRES_IN=7d

# Server Configuration
PORT=5000
NODE_ENV=development

# Client Configuration (for CORS)
CLIENT_URL=http://localhost:5173
